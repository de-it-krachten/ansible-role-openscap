---

# Generic
generic:
  role: ansible-role-openscap
  role_short: openscap
  role_description: |
    Installs & executes OpenSCAP for creating OVAL reports 
  collections: []

# Supported platforms
platforms:
  rockylinux10:
    supported: false
    ci: false
  debian11:
    supported: false
    ci: false
  debian12:
    supported: false
    ci: false
  debian13:
    supported: false
    ci: false
  fedora43:
    supported: false
    ci: false
  fedora44:
    supported: false
    ci: false

# Dependencies
dependencies:
  roles:
    - deitkrachten.cron
  collections: []

# Molecule
molecule:
  requirements:
    roles_extra:
      - deitkrachten.cron
  converge:
    become: no
    vars:
      openscap_central_download: true
      openscap_central_collection: true
      openscap_central_path: /var/log/openscap_central
      openscap_central_mode: "0644"
      openscap_oval: true
      openscap_oval_immediate: true
      openscap_ssg: true
      openscap_ssg_audit: true
      openscap_schedule_command: "/usr/local/bin/openscap-oval-report.sh -D"
      openscap_gpg_recipient: foo@example.com
      openscap_gpg_key: "{{ lookup('file', 'files/foo.pub') }}"
